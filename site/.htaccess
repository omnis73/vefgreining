ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTP_HOST} ^vefgreining\.com$ [NC]
RewriteRule ^(.*)$ https://www.vefgreining.com/$1 [R=301,L]
RewriteRule ^2022/05/27/ukraine-war-dashboards/?$ https://ukraine.vefgreining.com/ [R=301,L]
RewriteRule ^en/news(/.*)?$ /en/ [R=301,L]
RewriteRule ^news(/.*)?$ / [R=301,L]
RewriteRule ^(2017|2020|2021|2022)/ / [R=301,L]
RewriteRule ^category/ / [R=301,L]
RewriteRule ^feed/?$ / [R=301,L]
RewriteRule ^news/page/ / [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php) / [R=301,L]
RewriteRule ^(greinar|blog)/?$ / [R=301,L]
RewriteRule ^(sample-page|home|contact-us|our-history|our-achievements|our-vision|service-title-[234]|shop|cart|checkout|my-account)/?$ / [R=301,L]
